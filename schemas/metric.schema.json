{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ctc-fa.tsinderhoz.dev/schemas/metric.schema.json",
    "title": "CTC-FA v2.0 metric / model registry record",
    "type": "object",
    "required": ["model_id", "title", "version", "kind", "theory", "signature",
                 "signature_convention", "coordinates", "parameters",
                 "metric_defined", "topology", "identifications", "quotient",
                 "matter", "expected_status", "expected_scope", "provenance"],
    "additionalProperties": false,
    "properties": {
      "model_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "title": {"type": "string", "minLength": 3},
      "version": {"type": "string"},
      "kind": {"enum": ["LOCAL_METRIC", "QUOTIENT_GLOBAL", "COMPOSITE_GLOBAL",
                         "EXTERNAL_EXACT_SPEC"]},
      "theory": {"type": "string"},
      "signature": {"type": "array", "items": {"type": "integer"},
                    "minItems": 3, "maxItems": 3,
                    "description": "(n_negative, n_null, n_positive)"},
      "signature_convention": {"const": "(-,+,+,+)"},
      "coordinates": {"type": "array", "items": {"type": "string"}, "minItems": 0},
      "parameters": {"type": "array", "items": {"type": "string"}},
      "metric_defined": {"type": "boolean"},
      "metric_components": {
        "oneOf": [{"type": "null"},
                  {"type": "object", "additionalProperties": {"type": "string"}}],
        "description": "upper-triangular nonzero components keyed by 'ij'"},
      "topology": {"type": "string"},
      "identifications": {
        "type": "array",
        "items": {"type": "object",
                  "required": ["coordinate", "index", "period"],
                  "properties": {"coordinate": {"type": "string"},
                                  "index": {"type": "integer", "minimum": 0},
                                  "period": {"type": "string"},
                                  "requires_killing": {"type": "boolean"},
                                  "note": {"type": "string"}},
                  "additionalProperties": false}},
      "quotient": {
        "type": "object",
        "required": ["label", "generators"],
        "properties": {
          "label": {"type": "string"},
          "generators": {"type": "array", "items": {
            "type": "object", "required": ["name", "image", "inverse"],
            "properties": {"name": {"type": "string"},
                            "image": {"type": "array", "items": {"type": "string"}},
                            "inverse": {"type": "array", "items": {"type": "string"}},
                            "time_orientation_preserving": {"type": ["boolean", "null"]},
                            "note": {"type": "string"}},
            "additionalProperties": false}},
          "acts_freely": {"type": ["boolean", "null"]},
          "note": {"type": "string"}},
        "additionalProperties": false},
      "matter": {"type": "object",
                 "required": ["label", "vacuum"],
                 "properties": {"label": {"type": "string"},
                                 "vacuum": {"type": "boolean"},
                                 "Lambda": {"type": "string"},
                                 "T_defined": {"type": "boolean"},
                                 "note": {"type": "string"}},
                 "additionalProperties": false},
      "domain": {"type": "array", "items": {
        "type": "object", "required": ["name", "expression", "strict"],
        "properties": {"name": {"type": "string"},
                        "expression": {"type": "string"},
                        "strict": {"type": "boolean"},
                        "note": {"type": "string"}},
        "additionalProperties": false}},
      "default_point": {"type": "object",
                         "additionalProperties": {"type": "number"}},
      "expected_status": {"enum": ["CTC_PROVED", "CRITICAL", "NO_CTC_CERTIFIED",
                                    "UNRESOLVED"]},
      "expected_status_at_default_point": {
        "enum": ["CTC_PROVED", "CRITICAL", "NO_CTC_CERTIFIED", "UNRESOLVED"]},
      "expected_scope": {"enum": ["SECTOR", "REDUCED_MODEL", "DECLARED_DOMAIN",
                                   "GLOBAL"]},
      "domain_notes": {"type": "string"},
      "global_margin": {"type": "boolean"},
      "global_margin_scope": {"enum": ["SECTOR", "REDUCED_MODEL",
                                        "DECLARED_DOMAIN", "GLOBAL"]},
      "global_margin_note": {"type": "string"},
      "temporal_function": {"type": ["string", "null"]},
      "provenance": {"type": "object",
                      "required": ["source_refs"],
                      "properties": {
                        "source_refs": {"type": "array",
                                        "items": {"type": "string"},
                                        "minItems": 1},
                        "convention_note": {"type": "string"},
                        "derivation": {"type": "string"},
                        "implementation_status": {"type": "string"},
                        "external_spec": {"type": "string"}},
                      "additionalProperties": false},
      "metadata": {"type": "object"}
    },
    "allOf": [
      {"if": {"properties": {"kind": {"const": "LOCAL_METRIC"}}},
       "then": {"properties": {"metric_defined": {"const": true}}}},
      {"if": {"properties": {"kind": {"enum": ["EXTERNAL_EXACT_SPEC",
                                                "COMPOSITE_GLOBAL"]}}},
       "then": {"properties": {"metric_defined": {"const": false}}}},
      {"if": {"properties": {"global_margin": {"const": true}}},
       "then": {"properties": {"global_margin_scope": {"not": {"const": "GLOBAL"}}}}}
    ]
}
